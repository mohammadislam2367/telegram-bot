# ─── Anime Click Ultimate · local development only ────────────────────────────
# این فایل فقط برای اجرای محلی / نمونه است. مقادیر واقعی را در
# Supabase → Project Settings → Edge Functions → Secrets قرار دهید.
# این فایل را کپی کنید به .env و پر کنید؛ .env در gitignore است.

# توکن ربات تلگرام (از @BotFather)
TELEGRAM_BOT_TOKEN=

# رشته‌ی Secret که خودتان می‌سازید و در setWebhook استفاده می‌کنید
TELEGRAM_WEBHOOK_SECRET=

# شناسه‌ی عددی مالک اصلی (چندتایی با کاما جدا شود)
SUPER_ADMIN_IDS=

# Supabase
SUPABASE_URL=https://sbbxlwlgeyshrhmemovq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# کلید Gemini (Provider مستقل). اگر خالی باشد فقط Smart Fallback فعال است.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Secret مشترک برای فراخوانی تابع scheduler از pg_cron
SCHEDULER_SECRET=

# اختیاری
BOT_USERNAME=Spixle_bot
APP_TIMEZONE=Asia/Tehran
